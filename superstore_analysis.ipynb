   "source": [
    "df[\"Order Date\"] = pd.to_datetime(df[\"Order Date\"])\n",
    "df[\"Ship Date\"] = pd.to_datetime(df[\"Ship Date\"])\n",
    "df.info()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9588e723-08ff-4314-9526-c536eebe6e89",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"Year\"] = df[\"Order Date\"].dt.year\n",
    "df[\"Month Num\"] = df[\"Order Date\"].dt.month\n",
    "df[\"Month\"] = df[\"Order Date\"].dt.strftime(\"%b\")        # Jan, Feb...\n",
    "df[\"Year-Month\"] = df[\"Order Date\"].dt.to_period(\"M\").astype(str)\n",
    "df[\"Shipping Days\"] = (df[\"Ship Date\"] - df[\"Order Date\"]).dt.days\n",
    "df[\"Profit Margin %\"] = (df[\"Profit\"] / df[\"Sales\"]) * 100\n",
    "df[\"Is Loss\"] = np.where(df[\"Profit\"] < 0, \"Loss\", \"Profit\")\n",
    "\n",
    "# group discounts into bands\n",
    "df[\"Discount Band\"] = pd.cut(\n",
    "    df[\"Discount\"],\n",
    "    bins=[-0.01, 0, 0.2, 0.4, 1],\n",
    "    labels=[\"No Discount\", \"1-20%\", \"21-40%\", \">40%\"]\n",
    ")\n",
    "df.head()"
   ]
